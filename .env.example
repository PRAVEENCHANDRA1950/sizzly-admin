# Copy to .env to override. Every value is optional: without a .env the app
# uses the Sizzly Firebase web config (the same public config the Flutter app ships).

# Firebase web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Customer app URL used to build table QR codes (…/?table_id=<id>)
VITE_CUSTOMER_APP_URL=https://sizzly.ckbtech.in

# Optional comma-separated allowlist. When set, only these accounts can use the panel.
VITE_ADMIN_EMAILS=
